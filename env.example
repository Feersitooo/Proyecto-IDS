# Genera tu clave con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_DE_64_CARACTERES
APP_MODE=local
# Ruta relativa a la carpeta del proyecto. No se reinicia al arrancar.
DATABASE_PATH=instance/biblioteca.sqlite3
# Decisión del prototipo: aviso durante las próximas 48 horas.
DUE_SOON_HOURS=48
# 0 para HTTP local; 1 al servir la aplicación por HTTPS.
COOKIE_SECURE=0
TRUSTED_HOSTS=localhost,127.0.0.1
# Solo para la primera publicación: crea esquema vacío, nunca ejemplos.
INITIALIZE_EMPTY_DB=0
